# Runtime secret for src/pages/api/contact.ts (set on the Worker, not committed)
RESEND_API_KEY=
# Optional. Defaults to hello@scottdillinghamminiatures.com in src/consts.ts
RESEND_FROM_EMAIL=
# Worker secret. Resend segment for the new-pieces list.
RESEND_SEGMENT_ID=
# Optional Worker secret. Legacy Resend audience ID for the new-pieces list. src/pages/api/subscribe.ts uses it only as a fallback when RESEND_SEGMENT_ID is unset.
# RESEND_AUDIENCE_ID=
# Build-time public token. GitHub Actions secret PUBLIC_CF_BEACON_TOKEN.
PUBLIC_CF_BEACON_TOKEN=
# Build-time switch. Set to true to show the new-pieces list signup and enable /api/subscribe/.
# Leave unset until the privacy policy covers the mailing list.
PUBLIC_LIST_SIGNUP=
