---
export const prerender = true;

import CtaLink from '@/components/elements/cta-link.astro';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
---

<DefaultLayout
  title="Page Not Found"
  description="This page is not on the site. Browse the miniature furniture gallery or the woodworking guides."
  noindex={true}
>
  <section class="container flex min-h-[75vh] flex-col items-center justify-center gap-8 text-center">
    <p class="text-muted-foreground text-lg tracking-wide uppercase">404</p>
    <h1 class="text-4xl font-bold md:text-5xl lg:text-6xl">
      Even at 1:12 Scale,
      <br />
      <span class="text-primary">We Couldn't Find That Page</span>
    </h1>
    <p class="text-muted-foreground max-w-lg text-xl leading-relaxed">
      This piece must have wandered off the workbench. Let's get you back to
      the collection.
    </p>
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:gap-6">
      <CtaLink href="/gallery" label="Explore the Gallery" />
      <a
        href="/blog"
        class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
      >
        Browse Articles
      </a>
    </div>
  </section>
</DefaultLayout>
