---
export const prerender = true;

import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';

import bonsai from '@/assets/images/hero/bonsai.webp';
import SpeakableSchema from '@/components/schemas/SpeakableSchema.astro';
import BlogPreview from '@/components/sections/blog-preview.astro';
import FAQ from '@/components/sections/faq.astro';
import Features from '@/components/sections/features.astro';
import Hero from '@/components/sections/hero.astro';
import InReality from '@/components/sections/in-reality.astro';
import ValueProposition from '@/components/sections/value-proposition.astro';
import WhyUs from '@/components/sections/why-us.astro';
import { FAQ_DATA, SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroWidths = [640, 960, 1280] as const;
const heroAvifs = await Promise.all(
  heroWidths.map((width) =>
    getImage({ src: bonsai, width, format: 'avif', quality: 72 }),
  ),
);
const heroLcpSrcset = heroAvifs
  .map((img, i) => `${img.src} ${heroWidths[i]}w`)
  .join(', ');

// FAQPage structured data for Google rich results
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_DATA.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>/g, ''),
    },
  })),
};
---

<DefaultLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  image="/og-image.jpg"
  imageWidth={1600}
  imageHeight={840}
  imageAlt="1/12 scale miniature Windsor dining set with bonsai, handcrafted by Scott Dillingham"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroLcpSrcset}
    imagesizes="(max-width: 768px) 92vw, 644px"
    fetchpriority="high"
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <SpeakableSchema
    speakableSections={[
      { cssSelector: "[data-speakable='title']" },
      { cssSelector: "[data-speakable='description']" },
      { cssSelector: "[data-speakable='faq-question']" },
      { cssSelector: "[data-speakable='faq-answer']" },
    ]}
  />
  <Hero />
  <ValueProposition />
  <Features />
  <WhyUs />
  <InReality />
  <FAQ />
  <BlogPreview posts={posts} />
</DefaultLayout>
