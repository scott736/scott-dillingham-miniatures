---
export const prerender = true;

import { getCollection } from 'astro:content';

import { FAQ_DATA, SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

import SpeakableSchema from '@/components/schemas/SpeakableSchema.astro';
import BlogPosts from '@/components/sections/blog-posts';
import FAQ from '@/components/sections/faq';
import Features from '@/components/sections/features.astro';
import Hero from '@/components/sections/hero';
import InReality from '@/components/sections/in-reality';
import ValueProposition from '@/components/sections/value-proposition';
import WhyUs from '@/components/sections/why-us.astro';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// FAQPage structured data for Google rich results
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_DATA.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.replace(/<[^>]*>/g, ''),
    },
  })),
};
---

<DefaultLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <SpeakableSchema
    speakableSections={[
      { cssSelector: "[data-speakable='title']" },
      { cssSelector: "[data-speakable='description']" },
      { cssSelector: "[data-speakable='faq-question']" },
      { cssSelector: "[data-speakable='faq-answer']" },
    ]}
  />
  <Hero client:load />
  <ValueProposition client:visible />
  <Features />
  <WhyUs />
  <InReality client:visible />
  <FAQ client:visible />
  <BlogPosts posts={posts} client:visible />
</DefaultLayout>
