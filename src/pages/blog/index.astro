---
export const prerender = true;

import { getCollection } from 'astro:content';

import BlogPosts from '@/components/sections/blog-posts';
import { SITE_URL } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Miniature Furniture Blog',
  description:
    'Expert guides on miniature furniture making, 1/12 scale woodworking techniques, period styles, and collecting.',
  url: `${SITE_URL}/blog`,
  author: {
    '@type': 'Person',
    name: 'Scott Dillingham',
  },
  publisher: {
    '@id': `${SITE_URL}/#organization`,
  },
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: `${SITE_URL}/blog/${post.id}`,
    datePublished:
      post.data.pubDate instanceof Date
        ? post.data.pubDate.toISOString()
        : String(post.data.pubDate),
    author: {
      '@type': 'Person',
      name: post.data.authorName || 'Scott Dillingham',
    },
    image: post.data.coverImage
      ? `${SITE_URL}${post.data.coverImage}`
      : undefined,
  })),
};
---

<DefaultLayout
  title="Miniature Furniture Blog | Guides, Techniques & Collector Insights"
  description="Expert guides on miniature furniture making, 1/12 scale woodworking techniques, period styles, and collecting by museum-exhibited craftsman Scott Dillingham."
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  <div>
    <h1 class="sr-only">Miniature Furniture Blog</h1>
    <BlogPosts posts={posts} client:load isBlogsPage />
  </div>
</DefaultLayout>
