---
export const prerender = true;

import { getImage } from 'astro:assets';

import bonsai from '@/assets/images/hero/bonsai.webp';
import RelatedReading from '@/components/sections/related-reading.astro';
import WorkshopHero from '@/components/sections/workshop-hero.astro';
import WorkshopProcess from '@/components/sections/workshop-process.astro';
import WorkshopTools from '@/components/sections/workshop-tools.astro';
import { SITE_URL } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { imageObject, personRef } from '@/lib/schema';

const heroWidths = [640, 960, 1280] as const;
const heroAvifs = await Promise.all(
  heroWidths.map((width) =>
    getImage({ src: bonsai, width, format: 'avif', quality: 72 }),
  ),
);
const heroLcpSrcset = heroAvifs
  .map((img, i) => `${img.src} ${heroWidths[i]}w`)
  .join(', ');

const workshopRelatedPosts = [
  {
    slug: 'miniature-woodworking-for-beginners',
    title: 'Miniature Woodworking for Beginners',
    description:
      'Everything you need to know to start your journey in miniature woodworking, from tools to techniques.',
  },
  {
    slug: 'essential-miniature-woodworking-tools',
    title: 'Essential Miniature Woodworking Tools',
    description:
      'A comprehensive guide to the specialized tools every miniature furniture maker needs in their workshop.',
  },
  {
    slug: 'how-to-choose-wood-for-miniature-furniture',
    title: 'How to Choose Wood for Miniature Furniture',
    description:
      'Understanding grain scale, workability, and historical accuracy when selecting wood species for miniature work.',
  },
  {
    slug: 'miniature-woodworking-joints',
    title: 'Miniature Woodworking Joints',
    description:
      'Master the art of cutting dovetails, mortise and tenon, and other joints at 1/12 scale.',
  },
  {
    slug: 'finishing-techniques-miniature-furniture',
    title: 'Finishing Techniques for Miniature Furniture',
    description:
      'From French polish to oil finishes, learn how to achieve museum-quality surfaces on tiny pieces.',
  },
  {
    slug: 'setting-up-miniature-woodworking-workshop',
    title: 'Setting Up a Miniature Workshop',
    description:
      'How to organize and equip a dedicated workspace for miniature furniture making.',
  },
];

// HowTo schema for featured snippets on "how to make miniature furniture"
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Make Handcrafted 1/12 Scale Miniature Furniture',
  description:
    'The complete 8-step process for building museum-quality handcrafted miniature furniture from raw hardwood to finished masterpiece, by museum-exhibited craftsman Scott Dillingham.',
  author: personRef(),
  tool: [
    'Miniature hand planes',
    'Micro chisels and gouges',
    'Miniature dovetail saw',
    'Precision clamps',
    'Miniature lathe',
    'Magnification equipment',
  ],
  supply: [
    'Fine hardwoods (mahogany, cherry, walnut, maple, oak)',
    'Hide glue',
    'French polish or lacquer',
    'Brass hardware',
  ],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Design & Research',
      text: 'Study the original period furniture using historical references, museum archives, and antique photographs. Create scaled drawings that capture every proportion and detail.',
      image: imageObject({
        url: `${SITE_URL}/images/gallery/tall-case-clock.webp`,
        caption:
          'Finished 1/12 scale tall-case clock illustrating the design-research stage — not a photograph of the drawing board.',
      }),
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Wood Selection',
      text: 'Choose the right hardwood for grain pattern, workability at miniature scale, and historical accuracy to the period being reproduced.',
      image: imageObject({
        url: `${SITE_URL}/images/gallery/highboy-dresser.webp`,
        caption: 'Black walnut Queen Anne highboy — example of species chosen for grain and period accuracy.',
      }),
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Milling & Shaping',
      text: 'Cut raw stock to 1/12 scale dimensions with extreme precision. At this scale, tolerances are measured in fractions of a millimeter.',
      image: imageObject({
        url: `${SITE_URL}/images/gallery/four-poster-bed.webp`,
        caption: 'Shaker pencil-post bed — example of precise milling and shaping at 1/12 scale.',
      }),
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Joinery',
      text: 'Hand-cut dovetails, mortise and tenon joints at miniature scale. These are the same joints used in full-size period furniture.',
      image: imageObject({
        url: `${SITE_URL}/images/landing/workshop/dovetails.webp`,
        caption: 'Hand-cut miniature dovetails, shown as an example of 1/12 scale joinery.',
      }),
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Carving & Detail',
      text: 'Add shell carvings, fluting, and decorative elements by hand using micro chisels and gouges.',
      image: imageObject({
        url: `${SITE_URL}/images/gallery/hepplewhite-shield-back-chair.webp`,
        caption: 'Hand-carved Hepplewhite shield back — example of decorative work at 1/12 scale.',
      }),
    },
    {
      '@type': 'HowToStep',
      position: 6,
      name: 'Assembly',
      text: 'Carefully fit all components together. Every joint must be tight and true. Miniature clamps hold pieces in place while the glue sets.',
      image: imageObject({
        url: `${SITE_URL}/images/gallery/moser-continuous-arm-chair.webp`,
        caption: 'Fully assembled continuous-arm chair — every joint fitted by hand.',
      }),
    },
    {
      '@type': 'HowToStep',
      position: 7,
      name: 'Finishing',
      text: 'Apply French polish or lacquer for museum-quality protection. Multiple coats are hand-rubbed to build depth and warmth.',
      image: imageObject({
        url: `${SITE_URL}/images/gallery/maloof-rocking-chair.webp`,
        caption: 'Oil-finished Brazilian rosewood rocker — example of a completed museum-quality surface.',
      }),
    },
    {
      '@type': 'HowToStep',
      position: 8,
      name: 'Photography & Delivery',
      text: 'Document the finished piece with detailed photography, then carefully pack in custom-fitted foam for safe shipping worldwide.',
      image: imageObject({
        url: `${SITE_URL}/images/hero/bonsai.webp`,
        caption: 'Studio photograph of a finished 1/12 scale dining set.',
      }),
    },
  ],
};
---

<DefaultLayout
  title="How the Miniatures Are Made"
  description="Watch a 1/12 scale piece go from raw hardwood to finished furniture in Scott Dillingham's workshop. Hand tools, traditional joinery, no kits."
  image="/images/hero/bonsai.webp"
  imageWidth={1920}
  imageHeight={1326}
  imageAlt="1/12 scale miniature Windsor dining set with bonsai, handcrafted by Scott Dillingham"
  breadcrumbName="Workshop"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroLcpSrcset}
    imagesizes="(max-width: 768px) 92vw, 900px"
    fetchpriority="high"
  />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <WorkshopHero />
  <WorkshopProcess />
  <WorkshopTools />
  <RelatedReading
    title="Workshop Guides"
    subtitle="Master the craft with these in-depth technique guides."
    posts={workshopRelatedPosts}
  />
</DefaultLayout>
