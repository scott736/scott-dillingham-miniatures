---
export const prerender = true;

import RelatedReading from '@/components/sections/related-reading.astro';
import {
  galleryContactHref,
  GALLERY_ITEMS,
  GALLERY_STATUS,
} from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { galleryCollectionNode } from '@/lib/schema';

const galleryRelatedPosts = [
  {
    slug: 'how-to-start-miniature-furniture-collection',
    title: 'How to Start a Miniature Furniture Collection',
    description:
      "A collector's guide to beginning your journey into miniature furniture, from understanding quality to finding your first pieces.",
  },
  {
    slug: 'museum-quality-miniatures-what-sets-them-apart',
    title: 'Museum-Quality Miniatures: What Sets Them Apart',
    description:
      'Discover what separates museum-quality handcrafted miniatures from mass-produced pieces and why it matters for collectors.',
  },
  {
    slug: 'handcrafted-vs-kit-built-miniatures',
    title: 'Handcrafted vs. Kit-Built Miniatures',
    description:
      'Understanding the fundamental differences between handcrafted artisan miniatures and kit-built or factory-produced alternatives.',
  },
  {
    slug: 'investment-value-artisan-miniature-furniture',
    title: 'The Investment Value of Artisan Miniature Furniture',
    description:
      'Why handcrafted miniature furniture holds and increases in value, and what collectors should look for.',
  },
  {
    slug: 'displaying-protecting-miniature-furniture-collection',
    title: 'Displaying and Protecting Your Collection',
    description:
      'Best practices for displaying, lighting, and preserving your miniature furniture collection for years to come.',
  },
  {
    slug: 'miniature-furniture-fine-art',
    title: 'Miniature Furniture as Fine Art',
    description:
      'How miniature furniture transcends craft to become collectible fine art, with a look at galleries and exhibitions worldwide.',
  },
];

function stripHtml(html: string): string {
  return html.replace(/<[^>]*>/g, '');
}

function truncateText(text: string, maxLen: number): string {
  if (text.length <= maxLen) return text;
  const truncated = text.slice(0, maxLen);
  const lastSpace = truncated.lastIndexOf(' ');
  return (lastSpace > 0 ? truncated.slice(0, lastSpace) : truncated) + '...';
}

function relatedPostHref(href: string): string {
  return href.endsWith('/') ? href : `${href}/`;
}

const lightboxItems = GALLERY_ITEMS.map((item) => {
  const status = GALLERY_STATUS[item.availability];
  return {
    id: item.id,
    title: item.title,
    description: item.description,
    images: item.images,
    statusLabel: status.label,
    cta: status.cta,
    inquireHref: galleryContactHref(item.availability),
    relatedPost: item.relatedPost ? relatedPostHref(item.relatedPost) : null,
    alt: item.alt,
    priceOnRequest: item.availability === 'available',
  };
});
---

<DefaultLayout
  title="Miniature Furniture Gallery"
  description="Museum-exhibited 1/12 scale work: KSB-held Maloof, Willard, and Hepplewhite pieces are not for sale; other works are available or by commission."
  image="/images/gallery/highboy-dresser.webp"
  imageWidth={487}
  imageHeight={722}
  imageAlt="1/12 scale Queen Anne highboy in black walnut with bonnet top, carved fan, brass pulls, and cabriole legs by Scott Dillingham"
  breadcrumbName="Gallery"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(galleryCollectionNode())}
  />
  <section class="hero-padding container space-y-12">
    <div class="mx-auto max-w-3xl space-y-6 text-center">
      <h1 class="text-5xl leading-13 font-bold md:text-6xl md:leading-18">
        The Collection
      </h1>
      <p class="text-xl leading-8 text-balance">
        Museum-exhibited 1/12 scale furniture, each piece representing hundreds
        of hours of handcraft. Works in the KSB Miniatures Collection are not
        for sale. Other pieces are marked available or commission only —
        inquire to collect or commission similar work.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        GALLERY_ITEMS.map((item) => {
          const plain = stripHtml(item.description);
          const preview = truncateText(plain, 225);
          const status = GALLERY_STATUS[item.availability];
          const inquireHref = galleryContactHref(item.availability);
          const relatedHref = item.relatedPost
            ? relatedPostHref(item.relatedPost)
            : null;
          return (
            <article id={item.id} class="overflow-hidden">
              <div class="group overflow-hidden border-none shadow-none">
                <div class="relative aspect-[4/3] overflow-hidden rounded-2xl">
                  <img
                    src={item.images[0]}
                    alt={item.alt}
                    loading="lazy"
                    width={800}
                    height={600}
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/10" />
                </div>
                <div class="space-y-3 px-2 pt-4">
                  <p class="text-muted-foreground text-xs font-medium uppercase tracking-wider">
                    {status.label}
                  </p>
                  {item.availability === 'available' && (
                    <p class="text-sm leading-6">
                      Price on request. Ask about deposit and lead time.
                    </p>
                  )}
                  <h2 class="text-xl font-bold">
                    <a
                      href={'#' + item.id}
                      data-gallery-open={item.id}
                      class="hover:text-primary transition-colors"
                    >
                      {item.title}
                    </a>
                  </h2>
                  <p class="text-muted-foreground leading-7">{preview}</p>
                  <details>
                    <summary class="text-primary mt-1 cursor-pointer list-none text-sm font-medium hover:underline [&::-webkit-details-marker]:hidden">
                      Read more
                    </summary>
                    <div
                      class="text-muted-foreground [&_a]:text-primary mt-2 leading-7 [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:opacity-80"
                      set:html={item.description}
                    />
                  </details>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <a
                      href={inquireHref}
                      class="text-primary inline-flex items-center gap-1 text-sm font-medium hover:underline"
                    >
                      {status.cta}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-3.5"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg>
                    </a>
                    {relatedHref && (
                      <a
                        href={relatedHref}
                        class="text-muted-foreground inline-flex items-center gap-1 text-sm font-medium hover:underline"
                      >
                        Read Similar Story
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <script
    type="application/json"
    id="gallery-lightbox-data"
    set:html={JSON.stringify(lightboxItems)}
  />

  <dialog
    id="gallery-lightbox"
    class="bg-background text-foreground relative m-auto max-h-[90vh] w-[95vw] max-w-5xl overflow-y-auto rounded-2xl border-0 p-6 shadow-xl backdrop:bg-black/60 backdrop:backdrop-blur-sm"
    aria-labelledby="gallery-lightbox-title"
  >
    <form method="dialog" class="absolute top-4 right-4 z-10">
      <button
        type="submit"
        class="hover:bg-muted rounded-full p-1.5 transition-colors"
        aria-label="Close"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </form>
    <p
      data-gallery-status
      class="text-muted-foreground mb-2 text-xs font-medium tracking-wider uppercase"
    >
    </p>
    <p data-gallery-price class="mb-2 hidden text-sm leading-6"></p>
    <p id="gallery-lightbox-title" data-gallery-title class="mb-4 text-2xl font-bold">
    </p>
    <div data-gallery-figure class="relative select-none">
      <div class="overflow-hidden rounded-xl">
        <img
          data-gallery-image
          alt=""
          class="max-h-[70vh] w-full object-contain"
        />
      </div>
      <button
        type="button"
        data-gallery-prev
        class="absolute top-1/2 left-2 hidden -translate-y-1/2 rounded-full bg-white/80 p-1.5 shadow-md transition-colors hover:bg-white dark:bg-black/50 dark:hover:bg-black/70"
        aria-label="Previous image"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        data-gallery-next
        class="absolute top-1/2 right-2 hidden -translate-y-1/2 rounded-full bg-white/80 p-1.5 shadow-md transition-colors hover:bg-white dark:bg-black/50 dark:hover:bg-black/70"
        aria-label="Next image"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
      <div
        data-gallery-count
        class="absolute bottom-3 left-1/2 hidden -translate-x-1/2 rounded-full bg-black/60 px-2.5 py-1 text-xs text-white"
      >
      </div>
    </div>
    <div class="mt-4 space-y-3">
      <div
        data-gallery-description
        class="text-muted-foreground [&_a]:text-primary leading-7 [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:opacity-80"
      >
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          data-gallery-inquire
          href="/contact/"
          class="text-primary inline-flex items-center gap-1 text-sm font-medium hover:underline"
        >
        </a>
        <a
          data-gallery-related
          href="/"
          class="text-muted-foreground hidden items-center gap-1 text-sm font-medium hover:underline"
        >
          Read Similar Story
        </a>
      </div>
    </div>
  </dialog>

  <RelatedReading
    title="Collector's Library"
    subtitle="Deepen your appreciation for miniature furniture with these guides."
    posts={galleryRelatedPosts}
  />
</DefaultLayout>

<script>
  type LightboxItem = {
    id: string;
    title: string;
    description: string;
    images: string[];
    statusLabel: string;
    cta: string;
    inquireHref: string;
    relatedPost: string | null;
    alt: string;
    priceOnRequest: boolean;
  };

  function bindGalleryLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
    const dataEl = document.getElementById('gallery-lightbox-data');
    if (!dialog || !dataEl || dialog.dataset.bound === '1') return;

    let items: LightboxItem[] = [];
    try {
      items = JSON.parse(dataEl.textContent || '[]') as LightboxItem[];
    } catch {
      return;
    }

    const statusEl = dialog.querySelector<HTMLElement>('[data-gallery-status]');
    const titleEl = dialog.querySelector<HTMLElement>('[data-gallery-title]');
    const imageEl = dialog.querySelector<HTMLImageElement>('[data-gallery-image]');
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const countEl = dialog.querySelector<HTMLElement>('[data-gallery-count]');
    const descriptionEl = dialog.querySelector<HTMLElement>(
      '[data-gallery-description]',
    );
    const inquireEl = dialog.querySelector<HTMLAnchorElement>(
      '[data-gallery-inquire]',
    );
    const relatedEl = dialog.querySelector<HTMLAnchorElement>(
      '[data-gallery-related]',
    );
    const priceEl = dialog.querySelector<HTMLElement>('[data-gallery-price]');
    if (
      !statusEl ||
      !titleEl ||
      !imageEl ||
      !prevBtn ||
      !nextBtn ||
      !countEl ||
      !descriptionEl ||
      !inquireEl ||
      !relatedEl ||
      !priceEl
    ) {
      return;
    }

    dialog.dataset.bound = '1';

    let current: LightboxItem | null = null;
    let imageIndex = 0;

    const showImage = () => {
      if (!current) return;
      const total = current.images.length;
      const src = current.images[imageIndex];
      if (!src) return;
      imageEl.src = src;
      imageEl.alt =
        total > 1
          ? `${current.alt} (image ${imageIndex + 1} of ${total})`
          : current.alt;
      const multi = total > 1;
      prevBtn.classList.toggle('hidden', !multi);
      nextBtn.classList.toggle('hidden', !multi);
      countEl.classList.toggle('hidden', !multi);
      if (multi) countEl.textContent = `${imageIndex + 1} / ${total}`;
    };

    const openItem = (id: string) => {
      const item = items.find((entry) => entry.id === id);
      if (!item) return;
      current = item;
      imageIndex = 0;
      statusEl.textContent = item.statusLabel;
      if (item.priceOnRequest) {
        priceEl.textContent = 'Price on request. Ask about deposit and lead time.';
        priceEl.classList.remove('hidden');
      } else {
        priceEl.textContent = '';
        priceEl.classList.add('hidden');
      }
      titleEl.textContent = item.title;
      descriptionEl.innerHTML = item.description;
      inquireEl.href = item.inquireHref;
      inquireEl.textContent = item.cta;
      if (item.relatedPost) {
        relatedEl.href = item.relatedPost;
        relatedEl.classList.remove('hidden');
        relatedEl.classList.add('inline-flex');
      } else {
        relatedEl.classList.add('hidden');
        relatedEl.classList.remove('inline-flex');
      }
      showImage();
      if (!dialog.open) dialog.showModal();
    };

    document.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement | null)?.closest(
        '[data-gallery-open]',
      );
      if (!target) return;
      const id = target.getAttribute('data-gallery-open');
      if (!id) return;
      event.preventDefault();
      openItem(id);
    });

    prevBtn.addEventListener('click', () => {
      if (!current || current.images.length < 2) return;
      imageIndex = (imageIndex - 1 + current.images.length) % current.images.length;
      showImage();
    });

    nextBtn.addEventListener('click', () => {
      if (!current || current.images.length < 2) return;
      imageIndex = (imageIndex + 1) % current.images.length;
      showImage();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  bindGalleryLightbox();
  document.addEventListener('astro:page-load', bindGalleryLightbox);
</script>
