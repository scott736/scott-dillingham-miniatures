---
export const prerender = true;

import ContactPage from '@/components/sections/contact';
import { organizationRef } from '@/lib/schema';
import { SITE_URL } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Commission Custom Miniature Furniture',
  description:
    'Commission custom 1/12 scale miniature furniture from museum-exhibited craftsman Scott Dillingham.',
  url: `${SITE_URL}/contact/`,
  mainEntity: organizationRef(),
};
---

<DefaultLayout
  title="Commission a Piece"
  description="Commission custom 1/12 scale miniature furniture from Scott Dillingham, or inquire about finished pieces available for purchase."
  image="/og-image.jpg"
  imageWidth={1800}
  imageHeight={945}
  imageAlt="Scott Dillingham Miniatures - Handcrafted 1/12 Scale Miniature Furniture"
  breadcrumbName="Contact"
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <ContactPage client:visible />
</DefaultLayout>
