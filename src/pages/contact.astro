---
export const prerender = true;

import ContactPage from '@/components/sections/contact.astro';
import { SITE_URL } from '@/consts';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { organizationRef } from '@/lib/schema';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Commission Custom Miniature Furniture',
  description:
    'Commission custom 1/12 scale miniature furniture from museum-exhibited craftsman Scott Dillingham.',
  url: `${SITE_URL}/contact/`,
  mainEntity: organizationRef(),
};
---

<DefaultLayout
  title="Commission a Piece"
  description="Commission custom 1/12 scale miniature furniture from Scott Dillingham, or inquire about finished pieces that are available."
  image="/og-image.jpg"
  imageWidth={1600}
  imageHeight={840}
  imageAlt="1/12 scale miniature Windsor dining set with bonsai, handcrafted by Scott Dillingham"
  breadcrumbName="Contact"
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <ContactPage />
</DefaultLayout>
