---
import CtaLink from '@/components/elements/cta-link.astro';

const stats = [
  {
    value: '200+ Hours',
    description: 'The time invested in each complex piece — from raw wood to finished miniature masterpiece.',
  },
  {
    value: '1:12 Scale',
    description: 'Precision at one-inch scale. One inch in the miniature equals one foot in real life.',
  },
  {
    value: '30+ Years',
    description: 'Decades of woodworking experience brought to every cut, joint, and carved detail.',
  },
];
---

<section class="section-padding container space-y-10.5">
  <!-- Section Header -->
  <div class="flex flex-col gap-2.5 md:flex-row md:items-end">
    <div class="flex flex-1 flex-col gap-6 md:gap-8">
      <span class="inline-flex items-center justify-center rounded-full border py-2 ps-2.5 pe-4 text-xl font-normal w-fit whitespace-nowrap shrink-0 gap-3 text-foreground overflow-hidden">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"/><path d="M17.64 15 22 10.64"/><path d="m20.91 11.7-1.25-1.25c-.6-.6-.93-1.4-.93-2.25v-.86L16.01 4.6a5.56 5.56 0 0 0-3.94-1.64H9l.92.82A6.18 6.18 0 0 1 12 8.4v1.56l2 2h2.47l2.26 1.91"/></svg>
        The Maker
      </span>
      <h2 class="text-2xl md:text-4xl md:text-balance lg:text-5xl lg:leading-14">A Lifetime of Craft</h2>
    </div>
    <p class="flex-1 text-xl text-pretty md:text-end">
      With decades of woodworking experience and a passion for period furniture, Scott Dillingham creates miniature masterpieces that honor the traditions of master cabinetmakers.
    </p>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
    {stats.map((stat) => (
      <div class="bg-card text-card-foreground flex flex-col gap-20 rounded-3xl border-none p-8 shadow-none">
        <div>
          <div class="border-input text-muted-foreground flex size-12 items-center justify-center rounded-full border">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"/><path d="M17.64 15 22 10.64"/><path d="m20.91 11.7-1.25-1.25c-.6-.6-.93-1.4-.93-2.25v-.86L16.01 4.6a5.56 5.56 0 0 0-3.94-1.64H9l.92.82A6.18 6.18 0 0 1 12 8.4v1.56l2 2h2.47l2.26 1.91"/></svg>
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="text-3xl font-bold">{stat.value}</h3>
          <p class="text-xl leading-8">{stat.description}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- CTA Button -->
  <div class="flex justify-center">
    <CtaLink href="/about" label="About Scott" />
  </div>
</section>
