---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section class="section-padding container space-y-10.5">
  <div class="flex flex-col gap-2.5 md:flex-row md:items-end">
    <div class="flex flex-1 flex-col gap-6 md:gap-8">
      <span
        class="text-foreground inline-flex w-fit shrink-0 items-center justify-center gap-3 overflow-hidden rounded-full border py-2 ps-2.5 pe-4 text-xl font-normal whitespace-nowrap"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground"
          aria-hidden="true"
        >
          <path d="M15.5 2H8.6c-.4 0-.8.2-1.1.5-.3.3-.5.7-.5 1.1v12.8c0 .4.2.8.5 1.1.3.3.7.5 1.1.5h9.8c.4 0 .8-.2 1.1-.5.3-.3.5-.7.5-1.1V6.5L15.5 2z"></path>
          <path d="M3 7.6v12.8c0 .4.2.8.5 1.1.3.3.7.5 1.1.5h9.8"></path>
          <path d="M15 2v5h5"></path>
        </svg>
        Blog
      </span>
      <h2 class="text-2xl md:text-4xl md:text-balance lg:text-5xl lg:leading-14">
        From the Workshop Journal
      </h2>
    </div>
    <p class="flex-1 text-xl text-pretty md:text-end">
      Tips, techniques, and stories from the world of miniature woodworking.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-10.5">
    {
      posts.map((post) => (
        <a href={`/blog/${post.id}`} class="group block overflow-hidden">
          <div class="relative h-[320px] overflow-hidden rounded-3xl">
            <img
              src={post.data.coverImage}
              alt={`${post.data.title} - Miniature furniture article by Scott Dillingham`}
              width="400"
              height="320"
              loading="lazy"
              decoding="async"
              class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="space-y-2.5 py-6 transition-transform duration-300 group-hover:translate-x-6">
            <h3 class="text-2xl">{post.data.title}</h3>
            <time
              class="text-muted-foreground text-sm"
              datetime={post.data.pubDate.toISOString()}
            >
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
          </div>
        </a>
      ))
    }
  </div>
</section>
