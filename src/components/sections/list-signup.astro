---
interface Props {
  source?: string;
  piece?: string;
  heading?: string;
  body?: string;
  buttonLabel?: string;
}

const {
  source = 'website',
  piece,
  heading = 'New pieces go to the list first',
  body = 'A piece takes 40 to 200 hours, so only a few are finished at a time. Join the list and I will write when one is finished or a commission slot opens.',
  buttonLabel = 'Join the list',
} = Astro.props;

const inputClass =
  'border-input placeholder:text-input dark:bg-input/30 focus-visible:border-ring focus-visible:ring-ring/50 h-11 min-w-0 flex-1 rounded-lg border bg-transparent px-3 text-base outline-none focus-visible:ring-[3px] md:text-sm';
---

<section class="section-padding container">
  <div class="mx-auto max-w-2xl space-y-4 text-center">
    <h2 class="text-2xl font-bold md:text-4xl">{heading}</h2>
    <p class="text-muted-foreground text-lg leading-8">{body}</p>
    <form method="post" action="/api/subscribe/" class="mx-auto flex max-w-md flex-col gap-3 sm:flex-row">
      <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
        <label for={`list-website-${source}`}>Website</label>
        <input type="text" id={`list-website-${source}`} name="website" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="source" value={source} />
      {piece && <input type="hidden" name="piece" value={piece} />}
      <label class="sr-only" for={`list-email-${source}`}>Email</label>
      <input
        class={inputClass}
        type="email"
        id={`list-email-${source}`}
        name="email"
        placeholder="your@email.com"
        required
        maxlength="254"
      />
      <button
        type="submit"
        class="bg-primary text-primary-foreground inline-flex h-11 shrink-0 cursor-pointer items-center justify-center rounded-md px-5 text-sm font-medium shadow-xs hover:bg-primary/95"
      >
        {buttonLabel}
      </button>
    </form>
  </div>
</section>
