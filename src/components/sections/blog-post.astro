---
interface RelatedPost {
  id: string;
  title: string;
  description: string;
  image?: string;
  pubDate: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  coverImage?: string;
  postId: string;
  siteUrl: string;
  relatedPosts?: RelatedPost[];
}

const {
  title,
  description,
  pubDate,
  coverImage,
  postId,
  siteUrl,
  relatedPosts = [],
} = Astro.props;

const postUrl = `${siteUrl}/blog/${postId}`;
const encodedUrl = encodeURIComponent(postUrl);
const encodedTitle = encodeURIComponent(title);
const dateIso = pubDate instanceof Date ? pubDate.toISOString() : String(pubDate);
const dateLabel = new Date(dateIso).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const serviceCtas = [
  {
    title: 'Explore the Gallery',
    href: '/gallery',
    description:
      'See hundreds of hours of handcraft in our finished miniature furniture collection.',
  },
  {
    title: 'Inside the Workshop',
    href: '/workshop',
    description:
      'Discover the eight-step process behind every handcrafted miniature piece.',
  },
  {
    title: 'Commission a Piece',
    href: '/contact',
    description: "Ready for a custom miniature? Let's discuss your vision.",
  },
];
---

<article class="hero-padding-margin container space-y-6 md:space-y-8">
  <nav aria-label="Breadcrumb" class="text-muted-foreground text-sm">
    <ol class="flex items-center gap-1.5">
      <li>
        <a href="/" class="hover:text-foreground transition-colors">Home</a>
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline size-3.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </li>
      <li>
        <a href="/blog" class="hover:text-foreground transition-colors">Blog</a>
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline size-3.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </li>
      <li class="text-foreground max-w-[240px] truncate sm:max-w-none" aria-current="page">
        {title}
      </li>
    </ol>
  </nav>

  <div>
    <a href="/blog" class="group inline-block">
      <span class="[&>svg]:text-muted-foreground flex items-center gap-3 rounded-full border py-2 ps-2.5 pe-4 text-xl font-normal [&>svg]:size-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Back
      </span>
    </a>
    <h1 data-speakable="title" class="mt-3 text-2xl md:text-4xl lg:text-5xl">{title}</h1>
    <p data-speakable="description" class="mt-2.5 text-xl leading-8">{description}</p>
  </div>

  {
    coverImage && (
      <div class="relative h-[320px] overflow-hidden rounded-3xl md:h-[400px] lg:h-[600px]">
        <img
          src={coverImage}
          alt={`${title} - Miniature furniture guide by Scott Dillingham`}
          width={980}
          height={560}
          fetchpriority="high"
          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 768px, 980px"
          class="size-full object-cover"
        />
      </div>
    )
  }

  <div class="flex flex-wrap items-center justify-between gap-4">
    <time class="inline-block text-xl" datetime={dateIso}>{dateLabel}</time>
    <div class="flex items-center gap-3">
      <span class="text-muted-foreground text-sm">Share:</span>
      <a
        href={`https://pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-foreground inline-flex size-8 items-center justify-center rounded-full border transition-colors"
        aria-label="Share on Pinterest"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z" />
        </svg>
      </a>
      <a
        href={`https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-foreground inline-flex size-8 items-center justify-center rounded-full border transition-colors"
        aria-label="Share on X"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </a>
      <a
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-foreground inline-flex size-8 items-center justify-center rounded-full border transition-colors"
        aria-label="Share on Facebook"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
        </svg>
      </a>
      <a
        href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
        class="text-muted-foreground hover:text-foreground inline-flex size-8 items-center justify-center rounded-full border transition-colors"
        aria-label="Share on Email"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" x2="12" y1="2" y2="15"/></svg>
      </a>
    </div>
  </div>

  <div class="prose-headings:font-normal prose-headings:text-3xl dark:prose-invert prose prose-xl max-w-none leading-8">
    <slot />
  </div>

  <section class="pt-8 md:pt-12">
    <h2 class="mb-6 text-2xl md:text-3xl">Continue Your Journey</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      {
        serviceCtas.map((cta) => (
          <a href={cta.href} class="group">
            <div class="bg-card h-full rounded-xl border p-6 transition-colors hover:border-foreground/20">
              <div class="flex flex-col gap-3">
                <h3 class="text-lg font-medium">{cta.title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{cta.description}</p>
                <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {
    relatedPosts.length > 0 && (
      <section class="pt-8 md:pt-12">
        <div class="mb-6 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground size-5" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
          <h2 class="text-2xl md:text-3xl">Related Articles</h2>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          {relatedPosts.map((related) => (
            <a href={`/blog/${related.id}`} class="group">
              <div class="bg-card h-full overflow-hidden rounded-xl border p-0 transition-all hover:border-foreground/20">
                {related.image && (
                  <div class="relative h-[200px] overflow-hidden rounded-t-3xl">
                    <img
                      src={related.image}
                      alt={`${related.title} - 1/12 scale miniature furniture article`}
                      width={400}
                      height={200}
                      loading="lazy"
                      class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                    />
                  </div>
                )}
                <div class="px-5 py-5">
                  <h3 class="line-clamp-2 text-lg leading-snug font-medium">{related.title}</h3>
                  <p class="text-muted-foreground mt-2 line-clamp-2 text-sm leading-relaxed">
                    {related.description}
                  </p>
                  <time class="text-muted-foreground mt-3 block text-xs" datetime={related.pubDate}>
                    {new Date(related.pubDate).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</article>
