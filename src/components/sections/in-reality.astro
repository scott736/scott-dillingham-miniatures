---
import { Picture } from 'astro:assets';

import dovetails from '@/assets/images/landing/workshop/dovetails.webp';
import frenchPolish from '@/assets/images/landing/workshop/french-polish.webp';
import handCarving from '@/assets/images/landing/workshop/hand-carving.webp';
import CtaLink from '@/components/elements/cta-link.astro';

const WORKSHOP_IMAGES = [
  {
    src: handCarving,
    alt: 'Illustrative image of carving with a small chisel — not a photograph of this workshop',
    caption:
      'Illustrative image of carving, not a photograph of this workshop. Finished pieces in the gallery show the actual carved work.',
  },
  {
    src: dovetails,
    alt: 'Close-up of hand-cut miniature dovetail joints',
    caption: 'Hand-cut miniature dovetails, shown as an example of 1/12 scale joinery.',
  },
  {
    src: frenchPolish,
    alt: 'Illustrative interior with a writing desk — not Scott Dillingham\'s workshop',
    caption:
      'Illustrative image — not this workshop. Finished pieces in the gallery show the actual surfaces.',
  },
];
---

<section class="section-padding container space-y-10.5">
  <div class="flex flex-col gap-2.5 md:flex-row md:items-end">
    <div class="flex flex-1 flex-col gap-6 md:gap-8">
      <span
        class="text-foreground inline-flex w-fit shrink-0 items-center justify-center gap-3 overflow-hidden rounded-full border py-2 ps-2.5 pe-4 text-xl font-normal whitespace-nowrap"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground"
          aria-hidden="true"
        >
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
        Behind the Scenes
      </span>
      <h2 class="text-2xl md:text-4xl md:text-balance lg:text-5xl lg:leading-14">
        From the Workshop
      </h2>
    </div>
    <p class="flex-1 text-xl text-pretty md:text-end">
      A glimpse into the making process — where raw hardwood becomes a miniature
      masterpiece through patience, skill, and traditional techniques.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
    {
      WORKSHOP_IMAGES.map((image) => (
        <div class="group flex flex-col gap-4">
          <div class="relative h-[320px] overflow-hidden rounded-2xl sm:h-[400px]">
            <Picture
              src={image.src}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[400, 640, 800]}
              sizes="(max-width: 768px) 92vw, (max-width: 1024px) 30vw, 360px"
              alt={image.alt}
              width={800}
              height={400}
              quality={70}
              loading="lazy"
              decoding="async"
              class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <p class="text-muted-foreground text-base leading-7">{image.caption}</p>
        </div>
      ))
    }
  </div>

  <div class="flex justify-center pt-4">
    <CtaLink href="/workshop" label="Explore the Workshop" />
  </div>
</section>
