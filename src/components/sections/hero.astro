---
import { Picture } from 'astro:assets';

import bonsai from '@/assets/images/hero/bonsai.webp';
import CtaLink from '@/components/elements/cta-link.astro';
import { GALLERY_ITEMS } from '@/consts';

const availableCount = GALLERY_ITEMS.filter(
  (item) => item.availability === 'available',
).length;
const availableLabel =
  availableCount === 1 ? '1 piece available' : `${availableCount} pieces available`;
---

<section
  class="hero-padding container flex flex-col items-center justify-center gap-8 overflow-hidden !pb-0 text-center"
>
  <div class="flex w-full min-w-0 flex-col items-center gap-8">
    <div class="relative w-full max-w-[644px] min-w-0">
      <Picture
        src={bonsai}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 960, 1280]}
        sizes="(max-width: 768px) 92vw, 644px"
        alt="1/12 scale miniature Windsor dining set in front of a bonsai, handcrafted by Scott Dillingham"
        width={1280}
        height={884}
        quality={72}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full max-w-full rounded-2xl drop-shadow-2xl"
      />
    </div>

    <h1
      data-speakable="title"
      class="max-w-full text-balance text-4xl leading-tight font-bold sm:text-5xl sm:leading-13 md:text-6xl"
    >
      Miniature Furniture, Extraordinary Craft
    </h1>

    <p data-speakable="description" class="max-w-full text-xl leading-8 sm:max-w-3xl">
      Museum-exhibited 1/12 scale furniture, built by hand. On view at the{' '}
      <a class="underline underline-offset-2" href="/visit/">
        KSB Miniatures Collection, Maysville, Kentucky
      </a>
      .{' '}
      <a class="underline underline-offset-2" href="/gallery/">{availableLabel}</a>
      .{' '}
      <a class="underline underline-offset-2" href="/commissions/">Commissions are open</a>.
    </p>

    <div class="flex flex-col items-center gap-4 sm:flex-row sm:gap-6">
      <CtaLink href="/gallery/" label="See what's available" />

      <a
        href="/commissions/"
        class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
      >
        Commission a piece
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
