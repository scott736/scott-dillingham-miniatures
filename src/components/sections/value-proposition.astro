---
import { Picture } from 'astro:assets';

import finish from '@/assets/images/landing/value-proposition/finish.webp';
import joinery from '@/assets/images/landing/value-proposition/joinery.webp';
import noKits from '@/assets/images/landing/value-proposition/no-kits.webp';

const VALUE_ITEMS = [
  {
    title: 'No Kits, No Shortcuts',
    description:
      'Every piece built entirely from scratch using fine hardwoods — mahogany, cherry, walnut, and maple.',
    image: noKits,
    alt: 'Illustrative rack of woodworking chisels — not a photograph of this workshop',
  },
  {
    title: 'Traditional Joinery',
    description:
      "Precision dovetail joints mortise and tenon joints, and hand-carved details crafted with time-tested techniques I've learned.",
    image: joinery,
    alt: 'Close-up of hand-cut dovetail joints on a miniature drawer',
  },
  {
    title: 'Museum-Quality Finish',
    description:
      "Each piece is finished with hand-applied shellac or rich oil for exceptional depth, natural warmth, and enduring protection that highlights the wood's timeless beauty.",
    image: finish,
    alt: 'Illustrative image of a finish being rubbed — not a photograph of this workshop',
  },
];
---

<section class="bg-card py-15 md:py-20 lg:py-36">
  <div class="container flex flex-col items-center justify-center gap-12">
    <h2 class="text-center text-2xl font-bold md:text-3xl lg:text-5xl">
      <span class="m-1.5 inline-block md:m-4">Why Choose</span>
      <span class="m-1.5 inline-block md:m-4">Handcrafted</span>
    </h2>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 lg:gap-12">
      {
        VALUE_ITEMS.map((item) => (
          <div class="flex flex-col items-center gap-6 text-center">
            <div class="relative h-48 w-full overflow-hidden rounded-2xl">
              <Picture
                src={item.image}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[400, 640, 800]}
                sizes="(max-width: 768px) 92vw, (max-width: 1024px) 30vw, 360px"
                alt={item.alt}
                width={800}
                height={384}
                quality={70}
                loading="lazy"
                decoding="async"
                class="size-full object-cover"
              />
            </div>
            <h3 class="text-xl font-semibold md:text-2xl">{item.title}</h3>
            <p class="text-muted-foreground text-base leading-7 md:text-lg">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
