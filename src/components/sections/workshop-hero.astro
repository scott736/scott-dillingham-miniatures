---
import { Picture } from 'astro:assets';

import bonsai from '@/assets/images/hero/bonsai.webp';
---

<section class="hero-padding container flex flex-col items-center justify-center gap-8 text-center">
  <div class="flex flex-col items-center gap-8">
    <h1 class="text-5xl leading-13 font-bold md:text-6xl md:leading-18">
      The Maker's Workshop
    </h1>
    <p class="max-w-3xl text-xl leading-8 text-balance">
      Where raw hardwood becomes miniature art
    </p>
    <div class="relative mt-4">
      <Picture
        src={bonsai}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 960, 1280]}
        sizes="(max-width: 768px) 92vw, 900px"
        alt="1/12 scale miniature Windsor dining set in front of a bonsai, handcrafted by Scott Dillingham"
        width={1280}
        height={884}
        quality={72}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="rounded-3xl object-cover drop-shadow-2xl"
      />
    </div>
  </div>
</section>
