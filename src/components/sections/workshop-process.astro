---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import fourPoster from '@/assets/images/gallery/four-poster-bed.webp';
import hepplewhite from '@/assets/images/gallery/hepplewhite-shield-back-chair.webp';
import highboy from '@/assets/images/gallery/highboy-dresser.webp';
import rockingChair from '@/assets/images/gallery/maloof-rocking-chair.webp';
import moserChair from '@/assets/images/gallery/moser-continuous-arm-chair.webp';
import tallCaseClock from '@/assets/images/gallery/tall-case-clock.webp';
import bonsai from '@/assets/images/hero/bonsai.webp';
import dovetails from '@/assets/images/landing/workshop/dovetails.webp';

const steps: {
  number: string;
  title: string;
  description: string;
  image: ImageMetadata;
  alt: string;
  caption: string;
  relatedPost: { label: string; href: string } | null;
}[] = [
  {
    number: '01',
    title: 'Design & Research',
    description:
      'Every piece begins with studying the original period furniture. Historical references, museum archives, and antique photographs inform scaled drawings that capture every proportion and detail.',
    image: tallCaseClock,
    alt: '1/12 scale Simon Willard style tall-case clock in Honduras mahogany by Scott Dillingham',
    caption:
      'Example of a finished period reproduction. No photograph of the drawing board is shown.',
    relatedPost: {
      label: 'Scaling Down Plans',
      href: '/blog/scaling-down-furniture-plans',
    },
  },
  {
    number: '02',
    title: 'Wood Selection',
    description:
      'Choosing the right hardwood is critical. Each species is selected for its grain pattern, workability at miniature scale, and historical accuracy to the period being reproduced.',
    image: highboy,
    alt: '1/12 scale Queen Anne highboy in black walnut by Scott Dillingham',
    caption:
      'Black walnut highboy — an example of species chosen for grain and period accuracy.',
    relatedPost: {
      label: 'Choosing Wood Guide',
      href: '/blog/how-to-choose-wood-for-miniature-furniture',
    },
  },
  {
    number: '03',
    title: 'Milling & Shaping',
    description:
      'Raw stock is cut to 1/12 scale dimensions with extreme precision. At this scale, tolerances are measured in fractions of a millimeter. There is no room for error.',
    image: fourPoster,
    alt: '1/12 scale Shaker pencil-post bed in cherry by Scott Dillingham',
    caption:
      'Tapered pencil posts on a finished Shaker bed — the result of precise milling at 1/12 scale.',
    relatedPost: {
      label: 'Essential Tools',
      href: '/blog/essential-miniature-woodworking-tools',
    },
  },
  {
    number: '04',
    title: 'Joinery',
    description:
      'Hand-cutting dovetails, mortise and tenon joints at miniature scale. These are the same joints used in full-size period furniture, shrunk down to tiny dimensions.',
    image: dovetails,
    alt: 'Close-up of hand-cut miniature dovetail joints',
    caption: 'Hand-cut miniature dovetails, shown as an example of 1/12 scale joinery.',
    relatedPost: {
      label: 'Miniature Joints Guide',
      href: '/blog/miniature-woodworking-joints',
    },
  },
  {
    number: '05',
    title: 'Carving & Detail',
    description:
      'Adding shell carvings, fluting, and decorative elements by hand using micro chisels and gouges. This is where each piece truly comes alive with character.',
    image: hepplewhite,
    alt: '1/12 scale Hepplewhite shield-back chair with hand-carved splat by Scott Dillingham',
    caption:
      'Hand-carved Hepplewhite shield back — an example of decorative work at 1/12 scale.',
    relatedPost: null,
  },
  {
    number: '06',
    title: 'Assembly',
    description:
      'Carefully fitting all components together. Every joint must be tight and true. Miniature clamps hold pieces in place while the glue sets over hours.',
    image: moserChair,
    alt: '1/12 scale Thomas Moser continuous-arm chair in ash and cherry by Scott Dillingham',
    caption:
      'A fully assembled continuous-arm chair — every joint fitted by hand.',
    relatedPost: {
      label: 'Beginner Guide',
      href: '/blog/miniature-woodworking-for-beginners',
    },
  },
  {
    number: '07',
    title: 'Finishing',
    description:
      'Applying French polish or lacquer for museum-quality protection. Multiple coats are hand-rubbed to build depth and warmth, giving each piece its final glow.',
    image: rockingChair,
    alt: '1/12 scale Sam Maloof style rocking chair in Brazilian rosewood by Scott Dillingham',
    caption:
      'Oil-finished Brazilian rosewood rocker — an example of a completed museum-quality surface.',
    relatedPost: {
      label: 'Finishing Techniques',
      href: '/blog/finishing-techniques-miniature-furniture',
    },
  },
  {
    number: '08',
    title: 'Photography & Delivery',
    description:
      'Documenting the finished piece with detailed photography, then carefully packing in custom-fitted foam for safe shipping anywhere in the world.',
    image: bonsai,
    alt: '1/12 scale miniature Windsor dining set with bonsai, photographed for the studio',
    caption:
      'Studio photograph of a finished dining set, ready for collectors.',
    relatedPost: {
      label: 'Display & Protection Guide',
      href: '/blog/displaying-protecting-miniature-furniture-collection',
    },
  },
];
---

<section class="section-padding container space-y-12">
  <div class="flex flex-col items-start justify-center gap-2.5 md:flex-col md:items-center">
    <div class="flex flex-1 flex-col gap-3 md:items-center">
      <span class="[&>svg]:text-muted-foreground flex items-center gap-3 rounded-full border py-2 ps-2.5 pe-4 text-xl font-normal [&>svg]:size-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
        The Process
      </span>
      <h2 class="text-2xl md:text-4xl md:text-balance lg:text-5xl lg:leading-14">
        From Raw Hardwood to Finished Masterpiece
      </h2>
      <p class="text-muted-foreground max-w-2xl text-center text-lg leading-7">
        Each piece follows a meticulous eight-step process. The photographs below are finished 1/12 scale works from this studio, shown to illustrate each stage — not pictures of the bench mid-build.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-5xl">
    {
      steps.map((step, index) => {
        const isLeft = index % 2 === 0;
        const isLast = index === steps.length - 1;
        return (
          <div class="relative grid grid-cols-1 gap-6 py-6 md:grid-cols-[1fr_3rem_1fr] md:gap-8">
            <div class:list={['flex min-w-0 flex-col justify-center space-y-3', isLeft ? 'md:order-1' : 'md:order-3']}>
              <div class="flex items-center gap-3">
                <div class="border-input text-muted-foreground flex size-9 items-center justify-center rounded-full border">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                </div>
                <span class="text-muted-foreground text-sm font-medium">
                  Step {step.number}
                </span>
              </div>
              <h3 class="text-2xl font-bold">{step.title}</h3>
              <p class="text-lg leading-7">{step.description}</p>
              <p class="text-muted-foreground text-sm italic">{step.caption}</p>
              {step.relatedPost && (
                <a
                  href={step.relatedPost.href}
                  class="text-primary inline-flex items-center gap-1.5 text-sm font-medium hover:underline"
                >
                  {step.relatedPost.label}
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                </a>
              )}
            </div>
            <div class="hidden flex-col items-center md:order-2 md:flex">
              <div class="bg-primary flex size-10 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white">
                {step.number}
              </div>
              {!isLast && <div class="bg-border w-px flex-1" />}
            </div>
            <div class:list={['min-w-0 overflow-hidden rounded-2xl', isLeft ? 'md:order-3' : 'md:order-1']}>
              <Picture
                src={step.image}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[400, 640, 800]}
                sizes="(max-width: 768px) 92vw, 420px"
                alt={step.alt}
                width={800}
                height={500}
                quality={70}
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover"
              />
            </div>
          </div>
        );
      })
    }
  </div>
</section>
