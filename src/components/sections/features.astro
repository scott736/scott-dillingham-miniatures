---
import { Picture } from 'astro:assets';

import fourPoster from '@/assets/images/gallery/four-poster-bed.webp';
import highboy from '@/assets/images/gallery/highboy-dresser.webp';
import tallCaseClock from '@/assets/images/gallery/tall-case-clock.webp';
import rockingChair from '@/assets/images/gallery/windsor-chair.webp';
import CtaLink from '@/components/elements/cta-link.astro';
import { GALLERY_ITEMS } from '@/consts';

const previewImages = {
  'tall-case-clock': tallCaseClock,
  'highboy-dresser': highboy,
  'four-poster-bed': fourPoster,
  'maloof-rocking-chair': rockingChair,
} as const;

const previewItems = GALLERY_ITEMS.slice(0, 4);
---

<section class="section-padding container">
  <div class="flex flex-col gap-10">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="flex flex-col gap-4">
        <p class="text-muted-foreground text-sm font-medium uppercase tracking-wider">
          The Collection
        </p>
        <h2 class="text-2xl font-bold md:text-4xl lg:text-5xl">
          Gallery Highlights
        </h2>
      </div>
      <p class="text-muted-foreground max-w-md text-lg">
        Museum-exhibited handcrafted 1/12 scale pieces available for purchase
        — each one built entirely by hand from fine hardwoods.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {previewItems.map((item) => (
        <div class="group flex flex-col gap-4 overflow-hidden">
          <div class="relative h-[320px] overflow-hidden rounded-2xl">
            <Picture
              src={previewImages[item.id as keyof typeof previewImages]}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[400, 640, 800]}
              sizes="(max-width: 640px) 92vw, (max-width: 1024px) 45vw, 280px"
              alt={`${item.title} - Handcrafted 1/12 scale miniature in ${item.wood} for sale`}
              width={800}
              height={640}
              quality={70}
              loading="lazy"
              decoding="async"
              class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="space-y-1.5">
            <h3 class="text-lg font-semibold">
              {item.relatedPost ? (
                <a href={item.relatedPost} class="hover:text-primary transition-colors">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
            <p class="text-muted-foreground text-sm">{item.wood}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="flex justify-center pt-4">
      <CtaLink href="/gallery" label="View Full Gallery" />
    </div>
  </div>
</section>
