---
import { CONTACT_TO_EMAIL } from '@/consts';

const inputClass =
  'border-input placeholder:text-input selection:bg-primary selection:text-primary-foreground dark:bg-input/30 focus-visible:border-ring focus-visible:ring-ring/50 flex h-11 w-full min-w-0 rounded-lg border bg-transparent px-3 py-1 text-base outline-none transition-[color,box-shadow] focus-visible:ring-[3px] md:text-sm';
const labelClass = 'flex items-center gap-2 leading-none select-none';
---

<section class="hero-padding-margin container grid grid-cols-1 justify-between gap-10 md:grid-cols-2 lg:gap-10.5">
  <div class="flex-1 space-y-6">
    <div class="space-y-3">
      <span
        class="[&>svg]:text-muted-foreground flex w-fit items-center gap-3 rounded-full border py-2 ps-2.5 pe-4 text-xl font-normal [&>svg]:size-5"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
          <path d="M9 18h6"></path>
          <path d="M10 22h4"></path>
        </svg>
        Get in Touch
      </span>
      <h1 class="text-2xl font-bold md:text-4xl lg:text-5xl lg:leading-14">
        Let's Create Something Extraordinary
      </h1>
    </div>
    <p class="text-xl leading-8">
      Whether you're interested in commissioning a custom piece, have questions
      about the collection, or simply want to discuss miniature woodworking —
      I'd love to hear from you.
    </p>
    <p class="text-lg leading-8">
      Email the studio at
      <a
        class="text-primary font-medium underline underline-offset-2 hover:opacity-80"
        href={`mailto:${CONTACT_TO_EMAIL}`}
      >
        {CONTACT_TO_EMAIL}
      </a>
      or use the form.
    </p>
    <p class="text-muted-foreground text-sm italic">
      I personally read and respond to every message.
    </p>
  </div>

  <div class="bg-card text-card-foreground flex-1 rounded-3xl border py-8">
    <div class="space-y-3 px-8">
      <h2 class="text-3xl font-bold">Write to Me</h2>
      <p class="text-xl">I'd love to hear from you.</p>
    </div>

    <div class="px-8 pt-6">
      <p
        id="contact-sent"
        class="mb-6 text-sm font-medium text-green-600"
        hidden
      >
        Message sent! I'll get back to you soon.
      </p>
      <form method="post" action="/api/contact" class="flex flex-col gap-6">
        <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="space-y-1.5">
          <label class={labelClass} for="name">Name</label>
          <input
            class={inputClass}
            type="text"
            id="name"
            name="name"
            placeholder="Your name"
            required
            maxlength="200"
          />
        </div>

        <div class="space-y-1.5">
          <label class={labelClass} for="email">Email</label>
          <input
            class={inputClass}
            type="email"
            id="email"
            name="email"
            placeholder="your@email.com"
            required
            maxlength="254"
          />
        </div>

        <div class="space-y-1.5">
          <label class={labelClass} for="subject">Subject</label>
          <select
            id="subject"
            name="subject"
            class="border-input bg-background ring-offset-background placeholder:text-muted-foreground focus-visible:ring-ring flex h-10 w-full rounded-md border px-3 py-2 text-sm file:border-0 file:bg-transparent file:text-sm file:font-medium focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50"
          >
            <option value="">Select a subject...</option>
            <option value="general">General Inquiry</option>
            <option value="commission">Commission Request</option>
            <option value="collection">Collection Question</option>
            <option value="collaboration">Collaboration</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label class={labelClass} for="message">Message</label>
          <textarea
            class:list={[inputClass, 'min-h-[120px] py-2']}
            placeholder="Tell me about your project or question..."
            id="message"
            name="message"
            required
            maxlength="5000"
          ></textarea>
        </div>

        <button
          type="submit"
          class="bg-primary text-primary-foreground inline-flex h-14 w-full cursor-pointer items-center justify-center rounded-md px-6 text-sm font-medium shadow-xs hover:bg-primary/95"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    if (params.get('sent') === '1') {
      var el = document.getElementById('contact-sent');
      if (el) el.hidden = false;
    }
    var subject = params.get('subject');
    var select = document.getElementById('subject');
    if (subject && select) {
      var allowed = ['general', 'commission', 'collection', 'collaboration'];
      if (allowed.indexOf(subject) !== -1) select.value = subject;
    }
  })();
</script>
