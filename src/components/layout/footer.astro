---
import { FOOTER_LINKS, SOCIAL_LINKS } from '@/consts';
---

<footer class="bg-footer-background text-background py-11 md:py-15">
  <div class="container">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:gap-14">
      <div class="flex w-full flex-col divide-y md:w-auto md:flex-row md:items-center md:divide-x md:divide-y-0">
        <div class="md:pe-4 border-background/10 pb-4 md:pb-0 [&_img]:invert dark:[&_img]:invert-0">
          <a href="/" class="relative block w-56 h-16 lg:w-72 lg:h-20">
            <img
              src="/layout/sdmlogo.webp"
              alt="Scott Dillingham Miniatures"
              class="object-contain size-full"
              width="288"
              height="80"
            />
          </a>
        </div>

        <p class="pt-4 text-xl md:ps-4 md:pt-0">
          Heirloom-Quality Miniatures, Handcrafted with Passion
        </p>
      </div>

      <div class="grid flex-1 justify-center gap-6 md:flex md:grid-cols-3 md:gap-20 lg:gap-24">
        {FOOTER_LINKS.map((section) => (
          <div class="min-w-[120px]">
            <h3 class="text-xl">{section.title}</h3>
            <ul class="mt-3 space-y-2">
              {section.links.map((link) => (
                <li class="transition-opacity hover:opacity-80">
                  <a href={link.href}>{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-8 md:mt-10 flex flex-col justify-between gap-6 md:flex-row">
      <p class="text-xl opacity-70">
        &copy; {new Date().getFullYear()}. All rights reserved. Scott
        Dillingham Miniatures
      </p>

      <div class="flex gap-4">
        {SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            class="opacity-100 transition-opacity hover:opacity-80"
            target="_blank"
            rel="noopener noreferrer nofollow"
            aria-label={link.name}
          >
            {link.name === 'Instagram' ? (
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            ) : link.name === 'Pinterest' ? (
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="9"/><path d="M10.7 14.7C9.5 17.5 7 18 5.5 17c-1.5-1-.5-3.5 1-5s3.5-2 5-1c.5.3.8.7 1 1.2"/><circle cx="12" cy="12" r="10"/></svg>
            ) : (
              <span>{link.name}</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
