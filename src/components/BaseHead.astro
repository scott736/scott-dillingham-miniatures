---
import '@/styles/global.css';
import {
  organizationNode,
  personNode,
  personRef,
  websiteNode,
} from '@/lib/schema';
import { formatPageTitle, SITE_METADATA, SITE_TITLE, SITE_URL } from '../consts';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isNotFoundPage = Astro.url.pathname.replace(/\/$/, '') === '/404';

const { title, description, image, article, noindex } = Astro.props;
const finalTitle = formatPageTitle(title);
const finalDescription = description || SITE_METADATA.description;
const finalImage = image || SITE_METADATA.openGraph.images[0].url;
const imageURL = new URL(finalImage, Astro.url);

const organizationSchema = {
  '@context': 'https://schema.org',
  ...organizationNode(),
};

const personSchema = {
  '@context': 'https://schema.org',
  ...personNode(),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  ...websiteNode(),
};

const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: description,
      image: imageURL.toString(),
      author: personRef(),
      publisher: { '@id': `${SITE_URL}/#organization` },
      datePublished: article.pubDate,
      dateModified: article.updatedDate || article.pubDate,
      mainEntityOfPage: canonicalURL.toString(),
      keywords: article.tags ? article.tags.join(', ') : undefined,
    }
  : null;

const isBlogPost = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/';
const breadcrumbItems: Array<Record<string, unknown>> = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: SITE_URL,
  },
];
if (isBlogPost) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: 'Blog',
    item: `${SITE_URL}/blog/`,
  });
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: finalTitle,
    item: canonicalURL.toString(),
  });
} else if (Astro.url.pathname !== '/') {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: finalTitle,
    item: canonicalURL.toString(),
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---

<meta charset="utf-8" />

<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta
  name="robots"
  content={`${noindex ? 'noindex' : (SITE_METADATA.robots.index ? 'index' : 'noindex')}, ${SITE_METADATA.robots.follow ? 'follow' : 'nofollow'}`}
/>
<meta name="author" content={SITE_METADATA.authors[0].name} />
<meta name="creator" content={SITE_METADATA.creator} />
<meta name="publisher" content={SITE_METADATA.publisher} />
<meta name="theme-color" content="#6b2a3a" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<script is:inline>
  const savedTheme = localStorage.getItem('theme');
  const initialTheme = savedTheme || 'light';
  document.documentElement.classList.toggle('dark', initialTheme === 'dark');
</script>

{
  SITE_METADATA.icons.icon.map((icon) => (
    <link rel="icon" type={icon.type} sizes={icon.sizes} href={icon.url} />
  ))
}
{
  SITE_METADATA.icons.apple.map((icon) => (
    <link rel="apple-touch-icon" sizes={icon.sizes} href={icon.url} />
  ))
}
{
  SITE_METADATA.icons.shortcut.map((icon) => (
    <link rel="shortcut icon" href={icon.url} />
  ))
}

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>
<link rel="alternate" type="text/plain" title="LLM source" href={`${SITE_URL}/llms.txt`} />
<link rel="alternate" type="text/plain" title="LLM source (full)" href={`${SITE_URL}/llms-full.txt`} />
<link rel="alternate" type="application/json" title="LLM FAQ" href={`${SITE_URL}/llms-faq.json`} />
<link rel="alternate" type="text/plain" title="AI usage policy (ai.txt)" href={`${SITE_URL}/ai.txt`} />
<meta name="generator" content={Astro.generator} />

{
  !isNotFoundPage && (
    <>
      <link rel="canonical" href={canonicalURL} />
      <link rel="alternate" hreflang="en" href={canonicalURL} />
      <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    </>
  )
}

<title>{finalTitle}</title>
<meta name="title" content={finalTitle} />
<meta name="description" content={finalDescription} />

<meta property="og:type" content={article ? 'article' : 'website'} />
{!isNotFoundPage && <meta property="og:url" content={canonicalURL} />}
<meta property="og:site_name" content={SITE_METADATA.openGraph.siteName} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={imageURL} />
<meta
  property="og:image:width"
  content={SITE_METADATA.openGraph.images[0].width.toString()}
/>
<meta
  property="og:image:height"
  content={SITE_METADATA.openGraph.images[0].height.toString()}
/>
<meta property="og:image:alt" content={article ? `${title} - Miniature furniture by Scott Dillingham` : SITE_METADATA.openGraph.images[0].alt} />
<meta property="og:locale" content="en_US" />
{article && (
  <>
    <meta property="article:published_time" content={article.pubDate} />
    {article.updatedDate && <meta property="article:modified_time" content={article.updatedDate} />}
    <meta property="article:author" content={article.authorName || 'Scott Dillingham'} />
    <meta property="article:section" content="Miniature Furniture" />
    {article.tags?.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<meta property="twitter:card" content={SITE_METADATA.twitter.card} />
{!isNotFoundPage && <meta property="twitter:url" content={canonicalURL} />}
<meta property="twitter:title" content={finalTitle} />
<meta property="twitter:description" content={finalDescription} />
<meta property="twitter:image" content={imageURL} />
<meta property="twitter:creator" content={SITE_METADATA.twitter.creator} />
<meta name="twitter:image:alt" content={article ? `${title} - Miniature furniture by Scott Dillingham` : SITE_METADATA.openGraph.images[0].alt} />

<meta name="format-detection" content="telephone=no" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Scott Dillingham Miniatures" />
<link rel="manifest" href="/favicon/site.webmanifest" />

{
  !isNotFoundPage && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    </>
  )
}
{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

<link rel="preload" href="/fonts/Sora-latin-var.woff2" as="font" type="font/woff2" crossorigin />
